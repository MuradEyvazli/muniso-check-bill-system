# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/muniso?retryWrites=true&w=majority

# JWT — ZORUNLU. Kod içinde varsayılan/sabit bir değer yok; bunlar tanımlı
# değilse uygulama başlamaz (güvenlik için bilinçli olarak böyle). Rastgele,
# uzun ve tahmin edilemez değerler kullanın, örn: `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# App
NEXT_PUBLIC_APP_NAME=Muniso
NODE_ENV=development

# Cookie güvenliği — SADECE gerçek bir alan adı ve geçerli SSL sertifikasıyla
# (https://...) yayındaysanız "true" yapın. Restoranın kendi yerel ağında bir
# IP adresi üzerinden (ör. http://192.168.1.50:3000, TLS yok) çalıştırıyorsanız
# "false" bırakın — "true" yaparsanız tarayıcı oturum çerezini hiç saklamaz ve
# giriş yapılamaz hale gelir.
COOKIE_SECURE=false

# Print agent (local Node service, çalıştığı makinede)
PRINT_AGENT_URL=http://localhost:4001

# Seed — tüm şifre/PIN değerleri zorunludur, kod içinde sabit varsayılan yoktur.
# Bunlar eksikse `npm run seed` başlamadan hata verir.
SEED_RESTAURANT_NAME="Yegane Pilav"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_PIN=change-me-pin
SEED_KASIYER_USERNAME=kasiyer1
SEED_KASIYER_PASSWORD=change-me-strong-password
SEED_KASIYER_PIN=change-me-pin
SEED_GARSON_USERNAME=garson1
SEED_GARSON_PASSWORD=change-me-strong-password
SEED_GARSON_PIN=change-me-pin

# Raporlar bölümünde kayıt silme/sıfırlama işlemleri için onay şifresi
REPORTS_RESET_PASSWORD=1234
